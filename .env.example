# Required: public base URL of the mint. Its host is the domain ck1 spends
# bind to, and the mint is payable at {USERNAME}@{that host}.
BASE_URL=https://mint.example
# ONION_URL=http://<v3-address>.onion

# where the LNURL endpoints listen; put a TLS reverse proxy in front
LISTEN=127.0.0.1:8111

# The admin functions are always on a Unix socket, <DATA_DIR>/admin.sock
# (mode 0600), for lnurl-mint-cli. The admin HTTP API and its web UI are
# optional: served only when ADMIN_TOKEN is set, and requests carry
# "Authorization: Bearer <ADMIN_TOKEN>" (or the UI's session).
# ADMIN_SOCKET=data/admin.sock
ADMIN_LISTEN=127.0.0.1:8112
# ADMIN_TOKEN=<long random string>

# the seed (back it up), the node's channel state, the wallet and the note
# database all live here
# DATA_DIR=data       (the Docker image, and `make run`, use /data)
# DATABASE_PATH=data/mint.sqlite3   (an lnurl-mint mint.db opens as is)

# bitcoin, testnet, testnet4, signet or regtest
NETWORK=bitcoin

# The Lightning node (ldk-node: LDK, and BDK for its on-chain wallet) syncs
# from bitcoind.
# Unset BITCOIND_RPC to run without a node: rotate/split/merge still work,
# minting and melting answer "temporarily unavailable".
BITCOIND_RPC=127.0.0.1:8332
# either bitcoind's cookie file (when bitcoind writes a new one, the mint
# exits non-zero for its supervisor to restart it)...
BITCOIND_RPC_COOKIE=/var/lib/bitcoind/.cookie
# ...or a user and password
# BITCOIND_RPC_USER=lnurl-mint
# BITCOIND_RPC_PASSWORD=<password>

# Rapid Gossip Sync: the network graph at startup, from LDK's server on
# bitcoin (mainnet). Another server's /snapshot base URL, or "none" for peer
# gossip alone; other networks have no default.
# RGS_URL=https://rapidsync.lightningdevkit.org/snapshot

# An LSPS2 provider: opens the node's first inbound channel when a bootstrap
# invoice (`lnurl-mint-cli bootstrap`) is paid from outside the mint
# LSP_NODE=<pubkey>@lsp.example:9735
# LSP_TOKEN=

# where peers reach the node, and what public channels announce
LN_LISTEN=0.0.0.0:9735
# LN_ALIAS=my-mint                       (default: TITLE)
# LN_ANNOUNCE_ADDRESSES=203.0.113.7:9735

USERNAME=mint
MIN_SENDABLE_MSAT=10000
MAX_SENDABLE_MSAT=1000000000
BASE_FEE_MSAT=1000
FEE_PERCENT_PPM=0
MIN_MINT_MSAT=10000
MAX_K1S=100
SUNSET_MINT=false
# SUNSET_DATE=2027-01-01
VERIFY_ENABLED=true
USERNAME_REGISTRATION_ENABLED=true
NIP05_ENABLED=true

TITLE=lnurl-mint
DESCRIPTION=A minimal LNURLcash mint.
